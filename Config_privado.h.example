#pragma once

// ============================================================
//  Config_privado.h.example — modelo de configuração local
//
//  Como usar:
//    1. Copie este arquivo para "Config_privado.h" (sem .example)
//       na mesma pasta.
//    2. Preencha com as credenciais reais da sua rede Wi-Fi.
//    3. "Config_privado.h" já está no .gitignore — não será
//       commitado. Apenas este .example fica versionado.
//
//  Config.h inclui "Config_privado.h" automaticamente se ele
//  existir (via __has_include), antes de aplicar seus próprios
//  valores padrão com #ifndef — por isso só as definições abaixo
//  (que usam #ifndef em Config.h) têm efeito quando definidas aqui.
// ============================================================

// --- Wi-Fi STA (conexão com o roteador da casa/local) ---
#define WIFI_STA_ENABLED true
#define WIFI_STA_SSID "NOME_DA_SUA_REDE"
#define WIFI_STA_PASSWORD "SENHA_DA_SUA_REDE"

// --- Opcional: ajustes finos (normalmente não precisa mexer) ---
